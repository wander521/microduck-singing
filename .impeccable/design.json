      "name": "Primary playback button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Coral transport action, with icon and the current playback instruction.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 5 11 7-11 7V5Z\"/></svg><span>开始合唱</span></button>",
      "css": ".ds-primary{border:0;cursor:pointer;font-family:\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--ink,#203746);background:var(--coral,#bd4930);color:var(--paper,#fff7e7);border-radius:10px;display:flex;align-items:center;justify-content:center;gap:10px;padding:15px 23px;min-width:147px;min-height:52px;font-size:14px;font-weight:800}.ds-primary svg{width:18px;height:18px}.ds-primary:hover:not(:disabled){background:#9e3824;filter:brightness(.96)}.ds-primary:focus-visible{outline:3px solid var(--coral,#bd4930);outline-offset:4px}.ds-primary:disabled{opacity:.65;cursor:wait}"
    },
