    },
    {
      "name": "Programme navigation",
      "kind": "nav",
      "refersTo": "programme",
      "description": "Cream programme with numbered bilingual native selection buttons.",
      "html": "<nav class=\"ds-programme\" aria-label=\"选择曲目\"><h2>今日节目单</h2><button class=\"ds-piece\" aria-pressed=\"true\"><span class=\"ds-num\">01</span><span class=\"ds-track\"><strong>微光慢板</strong><small>Wistful</small></span><span class=\"ds-duration\">0:58</span></button><button class=\"ds-piece\" aria-pressed=\"false\"><span class=\"ds-num\">02</span><span class=\"ds-track\"><strong>鸭鸭摇摆</strong><small>Duck Strut</small></span><span class=\"ds-duration\">0:56</span></button></nav>",
      "css": ".ds-programme{font-family:\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--ink,#203746);width:264px;padding:24px 15px 16px;background:var(--paper,#fff7e7);border-radius:14px;box-shadow:0 8px 28px #264b4520}.ds-programme h2{font-size:20px;margin:0 9px 20px;letter-spacing:-.025em}.ds-piece{border:0;cursor:pointer;font-family:\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--ink,#203746);display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:transparent;padding:17px 10px;border-radius:9px;min-height:76px}.ds-piece:hover{background:#eee5d1;filter:brightness(.96)}.ds-piece[aria-pressed=true]{background:#263f50;color:var(--paper,#fff7e7)}.ds-piece:focus-visible{outline:3px solid var(--coral,#bd4930);outline-offset:4px}.ds-num,.ds-duration{font-size:11px;font-variant-numeric:tabular-nums}.ds-track{display:flex;flex:1;flex-direction:column;gap:6px}.ds-track strong{font-size:14px;font-weight:800}.ds-track small{font-size:10px;opacity:.8}"
    },
    {
      "name": "Voice audition",
      "kind": "button",
      "refersTo": "voice",
      "description": "Color dot and bilingual name identify a voice without relying on color alone.",
      "html": "<button class=\"ds-voice\" aria-pressed=\"false\" aria-label=\"单独试听低音\"><span class=\"ds-dot\"></span><span><strong>低音</strong><small>BASS</small></span></button>",
      "css": ".ds-voice{border:0;cursor:pointer;font-family:\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:var(--ink,#203746);display:flex;align-items:center;gap:10px;text-align:left;background:var(--paper,#fff7e7);padding:12px 17px;border-radius:10px;min-width:122px;min-height:58px;box-shadow:0 4px 14px #264b4510}.ds-voice:hover{filter:brightness(.96)}.ds-voice:focus-visible{outline:3px solid var(--coral,#bd4930);outline-offset:4px}.ds-voice[aria-pressed=true]{background:#263f50;color:var(--paper,#fff7e7)}.ds-voice[aria-pressed=true] small{color:#c8d6d9}.ds-voice.ds-muted{background:#dce6dc;box-shadow:none}.ds-dot{width:10px;height:10px;border-radius:50%;background:#846dba}.ds-voice strong{font-size:13px;font-weight:800}.ds-voice small{display:block;font-size:8px;letter-spacing:.06em;margin-top:4px;color:var(--muted,#566971)}"
    },
